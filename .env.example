# OpenRouter API Key (Required)
# Get key from https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# All models below are $0/token on OpenRouter as of Aug 2026 free-tier roster.
# Re-check via https://openrouter.ai/api/v1/models if models rotate/delist.
ORCHESTRATOR_MODEL=poolside/laguna-xs-2.1:free
RETRIEVAL_MODEL=poolside/laguna-xs-2.1:free
CRITIC_MODEL=poolside/laguna-s-2.1:free
SYNTHESIS_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
EMBEDDING_MODEL=nvidia/llama-nemotron-embed-vl-1b-v2:free

# Fallback used if a configured free model 404s / gets delisted
FALLBACK_MODEL=openrouter/free

# Free-tier Daily Budget Ceiling (OpenRouter account pool limit is 50/day; default 45 leaves 5 for manual UI)
DAILY_REQUEST_BUDGET=45

# Storage directory for persistent ChromaDB vector store
CHROMA_PERSIST_DIR=./data/chroma_db
